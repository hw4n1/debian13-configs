[global]
	follow	= mouse
	width	= 350
	height	= (0, 120)
	origin	= top-right
	offset	= (15, 40)
	padding	= 12
	horizontal_padding	= 12
	frame_width	= 2
	corner_radius	= 10
	font	= JetBrainsMono Nerd Font 10
	format	= "<b>%s</b>\n%b"
	frame_color	= "#cba6f7"
	separator_color	= frame

[urgency_low]
	background	= "#1e1e2e"
	foreground	= "#cdd6f4"
	frame_color	= "#94e2d5"
	timeout	= 5

[urgency_normal]
	background	= "#1e1e2e"
	foreground	= "#cdd6f4"
	frame_color	= "#cba6f7"
	timeout	= 8
[urgency_critical]
	background	= "#1e1e2e"
	foreground	= "#f38ba8"
	frame_color	= "#f38ba8"
	timeout	= 0


